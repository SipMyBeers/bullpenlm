{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BullpenLM",
  "version": "0.1.0",
  "identifier": "com.beerslabs.bullpenlm",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BullpenLM",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Multiplayer sales CRM where building a business is the meta-game.",
    "longDescription": "Self-hosted multiplayer sales CRM. Run your own bullpen, invite closers with one click, train against AI buyers, and compete on a live leaderboard. Open source, no cloud, no subscription.",
    "externalBin": ["binaries/bullpenlm-server", "binaries/whisper-cli"],
    "resources": [
      "../../templates/**/*",
      "../../server/**/*.py",
      "../../personas/_sample/**/*",
      "binaries/whisper-deps/*"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Dylan Beers (NV5993W4T4)",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "11.0"
    }
  }
}
