# BullpenLM — Apple notarization creds (local builds only).
#
# Copy this file to desktop/.env.notarize and fill in your values.
# That file is gitignored via .env.* — never commit real creds.
#
# Used by desktop/scripts/build-notarized.sh.

# Your Apple Developer email (same one you use to log in to developer.apple.com).
APPLE_ID="you@example.com"

# An *app-specific password* — NOT your Apple ID password.
# Generate one at https://account.apple.com/account/manage → App-Specific
# Passwords → Generate Password. Label it "BullpenLM notarization".
# Format is xxxx-xxxx-xxxx-xxxx (no quotes needed but harmless).
APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# Your Apple Developer Team ID. For Beers Labs LLC this is NV5993W4T4
# (already baked into tauri.conf.json as the signingIdentity).
# Find it at https://developer.apple.com/account → Membership → Team ID.
APPLE_TEAM_ID="NV5993W4T4"
