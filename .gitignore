# BullpenLM — what NOT to commit
# ──────────────────────────────────────────────────────────────────────
# Anything that's a host's PERSONAL data (calls, invites, audit logs,
# commissions, signed legal docs, training transcripts) stays out of
# git — those are per-instance, generated by each host's reps.
# Only CODE + TEMPLATES + PUBLIC MARKETING ships in the repo.

# ── Per-host data (each Bullpen instance generates its own) ──
bullpens/
team/
training-runs/

# ── Whisper / XTTS model binaries (large; downloaded at install time) ──
server/models/*.bin
*.bin
*.gguf

# ── Voice samples + clones — user-specific personal audio ──
personas/*/voice/sample.wav
personas/*/voice/verify.wav
personas/*/voice/clone_config.json

# ── Generated transcripts (private practice sessions) ──
personas/*/transcripts/*.txt
!personas/*/transcripts/README.txt
!personas/_sample/**

# ── Per-call recordings (real customer audio) ──
organizations/*/calls/

# ── Python ──
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
.pytest_cache/
*.egg-info/

# ── Secrets ──
.env
.env.*
*.key
*.pem

# ── OS / editor noise ──
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# ── Logs + tmp ──
*.log
/tmp/

# ── Packaged-for-friend zips (built on demand) ──
bullpenlm-share-*.zip

# ── Cloudflare wrangler caches ──
.wrangler/
node_modules/

# Bumblebee clip library — raw audio stays local (fair-use risk)
clips/*/*.mp3
clips/*/*.m4a
clips/*/*.wav
clips/*/*.ogg

# ── Tauri sidecar build artifacts ──
desktop/src-tauri/binaries/build/
desktop/src-tauri/binaries/dist/
desktop/src-tauri/binaries/bullpenlm-server-*
