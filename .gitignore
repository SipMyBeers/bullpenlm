# Whisper / XTTS models — pulled by install scripts, too big for git
server/models/*.bin
server/models/*.gguf
*.bin
*.gguf

# Voice samples + generated clones — user-specific, often contain real audio of real people
personas/*/voice/sample.wav
personas/*/voice/verify.wav
personas/*/voice/clone_config.json

# Generated transcripts from ingest-talk (user-specific data — opt-in to commit)
personas/*/transcripts/*.txt
!personas/*/transcripts/README.txt
!personas/_sample/**

# Training-run transcripts (private practice sessions)
training-runs/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# macOS
.DS_Store

# Editors
.vscode/
.idea/
*.swp

# Local secrets
.env
.env.local
